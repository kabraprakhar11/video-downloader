# ── Server Config ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Firebase Admin SDK (Backend) ──────────────────────────────
# Generate this from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Razorpay Config (Payments) ────────────────────────────────
# Generate this from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# ── yt-dlp Options ────────────────────────────────────────────
# Optional: Path to custom yt-dlp binary if not in system PATH
# YTDLP_PATH=yt-dlp
# Optional: Browser to extract cookies from (e.g. firefox, chrome, edge, safari)
COOKIE_BROWSER=firefox
