PORT=3000
NODE_ENV=development

# ── yt-dlp ────────────────────────────────────────────────────────────────────
# Path to yt-dlp binary (must be in PATH or provide full path)
YTDLP_PATH=yt-dlp

# Set this to a residential proxy to bypass 429 Too Many Requests datacenter IP bans on Render
# Format: http://username:password@proxy-ip:port
# YTDLP_PROXY=http://user:pass@123.45.67.89:8080

# Instagram session cookies (Netscape format) for accessing login-required & 18+ content
# Export from your browser using the "cookies.txt" extension, paste the full file content here
# INSTAGRAM_COOKIES="# Netscape HTTP Cookie File\n.instagram.com\tTRUE\t/\tTRUE\t...\tsessionid\tYOUR_SESSION_ID"

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Path to ffmpeg binary (must be in PATH or provide full path)
FFMPEG_PATH=ffmpeg

# ── Stripe (Sandbox) ──────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
# Create a product + price in Stripe dashboard → copy the price ID here
STRIPE_PREMIUM_PRICE_ID=price_YOUR_PRICE_ID_HERE
STRIPE_SUCCESS_URL=http://localhost:3000/?upgraded=true
STRIPE_CANCEL_URL=http://localhost:3000/

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Generate from Firebase console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Firebase Client SDK (safe to expose in browser) ───────────────────────────
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID_CLIENT=your-project-id
FIREBASE_APP_ID=1:000000000000:web:0000000000000000
